# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Dependencies
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Caches
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache

# Build outputs
build/Release
# Use `dist/*` (not `dist/`) so we can re-include dist/plugins/ below — git
# stops descending into a directory once its name is excluded by a parent
# pattern, and `dist/` would block the negation.
dist/*
# dist/plugins/ is the bundled plugin tree consumed by the Claude Code
# marketplace; it must be committed so `/plugin marketplace add` users get
# the self-contained build.
!dist/plugins/
!dist/plugins/**
output/

# OS
.DS_Store
**/.DS_Store

# Editor
.vscode-test
.tern-port

# Env
.env
.env.*
!.env.example

# pnpm / yarn
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Plugin-specific generated dirs
plugins/*/.generated/

# Packaged tarballs
*.tgz
*.zip
